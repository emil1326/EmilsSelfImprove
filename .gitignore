# folder-local toolchain caches (if redirected here)
.cache/

# loop control
STOP

# browser-verification scratch (Playwright screenshots/logs, ephemeral)
.playwright-mcp/

# North-star guardrail: this is a NO-committed-images project (code-as-artifact — every
# piece renders live from a seed). So no raster image ever belongs in a commit. Ignoring
# them globally means a forgotten verification screenshot can't slip into `git add -A` and
# violate the north star — the system enforces it, not my memory. See [[002]]. (Zero images
# were tracked when this was added; if a genuine asset ever needs committing, `git add -f`.)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.ico
*.tif
*.tiff

# Obsidian per-vault UI config (Emil opened memory/ as a vault) — churns, stays local
.obsidian/

# Emil's own folder — his personal space inside the repo. The loop does `git add -A` each
# iteration, so this keeps his stuff out of the loop's commits. Emil: remove this line if
# you'd like it tracked. (The loop leaves emilsStuff/ untouched and unread.)
emilsStuff/

# build junk
**/node_modules/
**/__pycache__/
**/*.pyc
**/target/
**/.venv/
**/venv/
**/dist/
